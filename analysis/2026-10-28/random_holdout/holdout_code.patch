 """
 
+from pathlib import Path
+
 import numpy as np
 import pandas as pd
 
@@ -18,6 +20,22 @@ CUTOFF = pd.Timestamp("2026-07-01")  # first test trading day
 # Last trading day any model trains on: refits after it reuse the same training data, so the models
 # are frozen from here and forecast the test without seeing it.
 TRAIN_END = CUTOFF - pd.Timedelta(days=1)
+# analysis/2026-10-28/random_holdout (this worktree only): trading days no model trains on (PLAN.md there). They are
+# still simulated and, once past, still public inputs; only the fits leave them out.
+HOLDOUT_FILE = Path(__file__).resolve().parents[1] / "analysis" / "2026-10-28" / "random_holdout" / "holdout_days.csv"
+HOLDOUT = pd.DatetimeIndex(pd.read_csv(HOLDOUT_FILE, parse_dates=["day"])["day"]).as_unit("ns")
+
+
+def held_out(days) -> np.ndarray:
+    """True for each trading day (any datetime unit; times dropped) that is held out."""
+    return pd.DatetimeIndex(days).as_unit("ns").normalize().isin(HOLDOUT)
+
+
+def no_holdout(days, where: str) -> None:
+    """PLAN.md check 1: raise if any trading day a fit uses is held out."""
+    hit = held_out(days)
+    if hit.any():
+        raise ValueError(f"{where}: {int(hit.sum())} training rows on held-out days")
 
 
